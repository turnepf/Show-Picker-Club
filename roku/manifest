title=Show Picker Club
major_version=1
minor_version=0
build_version=1

# Channel artwork, generated from the App Store icon mark. The focus icons are
# the tile on the Roku home screen and carry the channel name, because
# certification asks that the artwork "clearly represent the name or identity
# of the app" and a bare glyph leaves that to chance.
#
# Sizes are exact and not negotiable: mm_icon_focus_fhd is 540x405 and
# mm_icon_focus_hd is 290x218. The previous hd icon was 336x210 — a different
# aspect ratio entirely — and there was no fhd icon at all, which is a
# required attribute. mm_icon_focus_sd and the mm_icon_side_* pair are
# deprecated and have been dropped rather than shipped wrong.
mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.jpg
splash_screen_hd=pkg:/images/splash_hd.jpg
splash_screen_sd=pkg:/images/splash_sd.jpg
splash_color=#0D0F14
splash_min_time=500

ui_resolutions=fhd
# FORCE_LEGACY is a build-time override, never shipped true. `node
# sideload.mjs --legacy` flips it in the STAGED copy only, so the legacy tier
# can be exercised on a modern device — a tier nobody can run is a tier nobody
# has checked.
bs_const=DEBUG=false;FORCE_LEGACY=false

# No supports_input_launch until deep linking is actually implemented. main.brs
# hands `input` to MainScene.launchArgs and nothing reads it, so declaring the
# support made external launches look broken rather than unsupported — and a
# channel that claims it has to honour contentId/mediaType to pass Roku
# certification. Re-add it with the handler, not before.
