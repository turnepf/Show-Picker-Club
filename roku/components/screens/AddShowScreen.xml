<?xml version="1.0" encoding="utf-8" ?>
<component name="AddShowScreen" extends="Group">
    <interface>
        <field id="authState" type="assocarray" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/Globals.brs" />
    <script type="text/brightscript" uri="pkg:/source/ContentBuilders.brs" />
    <script type="text/brightscript" uri="AddShowScreen.brs" />
    <children>
        <Label id="heading" text="Add a Show" translation="[90,54]" font="font:LargeBoldSystemFont" color="0xF5F7FAFF" />
        <Keyboard id="kb" translation="[90,140]" />
        <ButtonGroup id="buttons" translation="[90,770]" layoutDirection="horiz"
                     buttonHeight="56" minWidth="180" horizAlignment="left" />
        <MarkupGrid id="grid" translation="[720,140]" itemComponentName="PosterCard"
                    numColumns="3" numRows="2" itemSize="[280,440]"
                    itemSpacing="[24,30]" vertFocusAnimationStyle="floatingFocus" />
        <Label id="message" translation="[720,140]" width="1100" wrap="true"
               font="font:MediumSystemFont" color="0xFFFFFF99" visible="false" />
        <!-- ✱ is the one key the Keyboard never claims on any firmware, so it is
             the escape that always works. Named on screen because it is not
             discoverable otherwise. -->
        <Label id="hint" text="Press ✱ to switch between the keyboard and the buttons"
               translation="[90,1020]" font="font:SmallestSystemFont" color="0xFFFFFF99" />
    </children>
</component>
