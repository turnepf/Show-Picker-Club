<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/Globals.brs" />
    <script type="text/brightscript" uri="pkg:/source/ContentBuilders.brs" />
    <script type="text/brightscript" uri="MainScene.brs" />
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x0D0F14FF" />
        <Group id="viewHolder" />
        <!-- BusySpinner draws its own internal poster from `uri`. A nested
             <Poster> is just an extra static child and never spins. -->
        <BusySpinner id="spinner" translation="[930,500]" visible="false"
                     uri="pkg:/images/spinner.png" control="stop" />
    </children>
</component>
