# CSP was tightened with the 2026-08 teardown: the web no longer signs anyone
# in, so the Apple/Google/Turnstile script, frame and form-action sources that
# the member app needed are gone. What's left is what the marketing page loads —
# Google Analytics, Cloudflare Insights, and TMDB poster art. Keep comments at
# column 0: an indented line inside a rule block is parsed as a header.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://image.tmdb.org; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.google-analytics.com https://cloudflareinsights.com; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; worker-src 'self'

# Apple's CDN requires the app-site-association file be served as JSON
# (it has no extension, so Pages would otherwise guess octet-stream).
/.well-known/apple-app-site-association
  Content-Type: application/json
